# Optional. Everything is configured in the web UI (Settings) and stored,
# encrypted, in the data volume. Copy to .env to set any of these.

# PORT=8080
# Reverse proxies that may set X-Forwarded-Proto/For (default 127.0.0.1 only).
# Needed for "HTTPS only" if the proxy runs on another host.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Key for stored secrets. Unset: generated into the data volume. Setting it keeps
# it out of the volume and its backups. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Create the first admin without the setup token (only used while there are no users).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Any UI setting can also be given here: it then shows read-only on the Settings
# page and overrides the stored value. Useful to pin security switches, e.g.:
# ALLOW_IMAGE_EDITING=false     # nobody can turn on editing image definitions
# HTTPS_ONLY_COOKIES=true       # Secure cookies and HSTS, whatever the UI says
# VSPHERE_SERVER=vcenter.example.com

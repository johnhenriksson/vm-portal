# Optional. Everything is configured in the web UI (Settings) and stored,
# encrypted, in the data volume. Copy to .env to set any of these.

# PORT=8080
# Set to true when served over HTTPS (e.g. behind a reverse proxy). Also enables HSTS.
# HTTPS_ONLY_COOKIES=false

# Key for stored secrets. Unset: generated into the data volume. Setting it keeps
# it out of the volume and its backups. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Create the first admin without the setup token (only used while there are no users).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Let admins create and edit Packer image definitions in the browser. Definitions
# are code that runs inside the portal; enable only if you trust every admin with that.
# ALLOW_IMAGE_EDITING=false

# Any UI setting can also be given here (it then shows read-only), e.g.:
# VSPHERE_SERVER=vcenter.example.com
